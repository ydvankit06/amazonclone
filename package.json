  "version": "1.0.0",
  "description": "Full-stack Amazon-style e-commerce clone with React/Vite frontend and Express/PostgreSQL backend.",
  "scripts": {
    "dev": "npm run dev --workspace frontend",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
