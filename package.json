    "preview": "npm run preview --workspace frontend",
    "start": "npm run start --workspace backend"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "amazon-clone",
    "react",
    "vite",
    "express",
    "postgresql"
  ],
