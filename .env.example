# Backend server
PORT=5000

# PostgreSQL connection
PGHOST=localhost
PGPORT=5432
PGUSER=your_db_user
PGPASSWORD=your_db_password
PGDATABASE=amazon_clone

# Or use a full connection string instead of the above:
# DATABASE_URL=postgres://user:password@localhost:5432/amazon_clone

# CORS
CORS_ORIGIN=http://localhost:5173

# Order email notifications
ORDER_NOTIFICATION_EMAIL=ankitempire06@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=Amazon Clone <your_email@gmail.com>

